{
  "name": "dsh-fg",
  "version": "1.0.0",
  "description": "DeepSeek Harness 峰谷时段提醒：输入框中的繁忙期与空闲期图标、切换倒计时和时段提醒。",
  "type": "module",
  "license": "MIT",
  "author": "R-ADD-R",
  "homepage": "https://github.com/R-ADD-R/dsh-peak-idle#readme",
  "repository": { "type": "git", "url": "git+https://github.com/R-ADD-R/dsh-peak-idle.git" },
  "bugs": { "url": "https://github.com/R-ADD-R/dsh-peak-idle/issues" },
  "keywords": ["dsh-plugin", "deepseek", "deepseek-harness", "peak-hours", "off-peak", "billing", "desktop"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/period.test.ts tests/store.test.ts tests/bundle.test.ts",
    "test:ui": "playwright test",
    "check": "pnpm typecheck && pnpm build && pnpm test && pnpm test:ui",
    "verify:package": "node scripts/verify-package.mjs",
    "publish:check": "pnpm typecheck && pnpm build && pnpm test && pnpm verify:package",
    "pack:plugin": "pnpm build && pnpm verify:package && pnpm pack --pack-destination releases"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@11.25.0"
}
